    <!-- Help -->
    <string name="help">Help</string>
    <string name="help_tools">Tools</string>
    <string name="help_pen">Writes in the colour and width chosen. Hold the pen still at the end of a stroke to make it a straight line.</string>
    <string name="help_highlighter">Marks over what is on the page, see-through.</string>
    <string name="help_eraser">Standard erases what it goes over, Whiteout paints white over it, and Delete stroke removes every stroke it touches.</string>
    <string name="help_select">Selects with a rectangle or a lasso, or a tap on one thing. Drag the selection to move it, a corner to resize it, the handle above it to turn it. The colours and widths restyle it, and the bar above it cuts, copies, pastes, duplicates and deletes.</string>
    <string name="help_text">Tap to write text, or tap text to change it. The toolbar chooses its font, size and colour.</string>
    <string name="help_options">The chosen tool\'s options</string>
    <string name="help_shape_title">Shape</string>
    <string name="help_shape">Writes freehand, or draws a line, rectangle, ellipse, arrow, double arrow or coordinate system from where the pen goes down to where it lifts.</string>
    <string name="help_colors">The colour to write with. + picks any colour, and the ones picked are kept next to the others. Settings chooses the colours always offered.</string>
    <string name="help_widths">How wide the pen, highlighter or eraser is. Settings chooses the widths offered.</string>
    <string name="help_pressure">When on, pressing harder writes wider. When off, the pen writes at its width however hard it presses.</string>
    <string name="help_finger">When on, a finger writes like the stylus, and two fingers scroll and zoom. When off, fingers only scroll and zoom. Settings can hide this button.</string>
    <string name="help_top_bar">The note\'s top bar</string>
    <string name="help_undo_title">Undo and redo</string>
    <string name="help_undo">Undoes the last change, or does it again.</string>
    <string name="help_pages">Shows the pages: tap one to go to it, hold one and drag it to move it. Its buttons add, duplicate and delete pages and change their background.</string>
    <string name="help_insert_page">Adds a page after the one in view.</string>
    <string name="help_layers">Shows the page\'s layers: choose the one to write on, show or hide them, add, reorder, merge and rename them.</string>
    <string name="help_paste">Pastes what was copied, or a picture copied in another app.</string>
    <string name="help_image">Puts a picture from the gallery on the page, ready to move and resize.</string>
    <string name="help_photo">Takes a photo with the camera and puts it on the page.</string>
    <string name="help_export_title">Export and share</string>
    <string name="help_export">Saves the note as a PDF, or sends it as a PDF to another app.</string>
    <string name="help_page_zoom_title">The page and the zoom</string>
    <string name="help_page_zoom">At the bottom of the note: tap the page number to go to another page, and the zoom to fit the width, fit the page, or show it at its real size.</string>
    <string name="help_input">Stylus, fingers and keyboard</string>
    <string name="help_button_title">The stylus\'s side button</string>
    <string name="help_button">Holding it erases. Settings can make it highlight instead, or do nothing.</string>
    <string name="help_eraser_end_title">The stylus\'s eraser end</string>
    <string name="help_eraser_end">Erases, whatever tool is chosen.</string>
    <string name="help_hover_title">Holding the stylus near the screen</string>
    <string name="help_hover">Shows where it will write. Over a button, it shows the button\'s name, as holding the button does.</string>
    <string name="help_fingers_title">Fingers</string>
    <string name="help_fingers">One finger scrolls, and two fingers zoom. A palm resting on the screen while the stylus writes is ignored.</string>
    <string name="help_keyboard_title">Keyboard</string>
    <string name="help_keyboard">Meta + / lists the keyboard shortcuts.</string>
    <string name="help_library">Library</string>
    <string name="help_new_folder">Makes a folder in this one.</string>
    <string name="help_new_note">Starts a note here, with the paper size and background chosen.</string>
    <string name="help_card_menu_title">A card\'s menu</string>
    <string name="help_card_menu">Renames, moves or deletes a note, PDF or folder. A note on a PDF keeps its PDF with it.</string>
    <string name="help_drag_title">Holding a card</string>
    <string name="help_drag">Picks it up: drag it onto a folder, a library\'s heading or a folder in the path at the top to move it there.</string>
    <string name="help_pdf_title">PDFs</string>
    <string name="help_pdf">Tap a PDF to write on it. Its note is made next to it, and from then on the note stands for the PDF.</string>
    <string name="help_settings">The library\'s folders and their order, colours, widths, the stylus\'s button, new pages and appearance.</string>
    <string name="help_names_title">Button names</string>
    <string name="help_names">Hold a button, or the stylus over it, to see its name.</string>
    <string name="finger_button">“Draw with finger” in the toolbar</string>
    <string name="finger_button_summary">A button that lets fingers write; without it, fingers scroll and zoom, and only the stylus writes</string>
